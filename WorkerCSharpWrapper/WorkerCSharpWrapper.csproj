<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Em net48 o LangVersion cai para C# 7.3 por padrao, o que quebra o
         construtor primario de TraceOnlineMessage e o new() target-typed. -->
    <LangVersion>latest</LangVersion>
    <!-- A versao do assembly nao muda: quem ja foi compilado com a DLL anterior
         continua carregando esta. A do arquivo diz qual e. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sem isto as DLLs de modules/ entram no glob default de None e viram
         {CandidateAssemblyFiles}, que o RAR consulta ANTES do {HintPathFromItem}.
         O resultado seria a DLL net48 sendo usada tambem no alvo net8.0. -->
    <None Remove="modules\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Permite compilar o alvo net48 fora do Windows. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="ZapMQWrapper">
      <HintPath>modules\net48\ZapMQWrapper.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Reference Include="ZapMQWrapper">
      <HintPath>modules\netstandard2.0\ZapMQWrapper.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
